# ==========================================
# Nora Project — Environment Variables Example
# Copiar este archivo a .env y reemplazar los valores
# ==========================================

# Supabase Cloud Configuration
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Database Direct Connection
SUPABASE_DB_PASSWORD=your-database-password
DATABASE_URL=postgresql://postgres:your-database-password@db.your-project-ref.supabase.co:5432/postgres

# AI Assistant LLM Provider (Gemini / Claude / OpenAI)
LLM_PROVIDER=gemini
LLM_API_KEY=your-llm-api-key

# Deployment Server (Visar)
VISAR_HOST=your-server-ip
VISAR_USER=root
VISAR_DOMAIN=nora.vis7ar.com
VISAR_API_DOMAIN=api.nora.vis7ar.com
